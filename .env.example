# ==============================================================================
# Cloud-Native Data Platform - Runtime Environment Secrets Template
# Copy this file to .env and adjust values for custom or production deployments.
# DO NOT commit .env containing production secrets to git.
# ==============================================================================

# --- Platform Storage: MinIO Lakehouse ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio.platform.svc.cluster.local:9000

# --- Platform Database: PostgreSQL ---
POSTGRES_PASSWORD=postgres-super-secure-password

# --- SRE Observability: Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana-admin-password

# --- Application: order-service ---
ORDER_SERVICE_PORT=8080
ORDER_SERVICE_REDPANDA_BROKERS=redpanda.platform.svc.cluster.local:9092
ORDER_SERVICE_TOPIC=orders.lifecycle

# --- Application: rider-service ---
RIDER_SERVICE_PORT=8081
RIDER_SERVICE_REDPANDA_BROKERS=redpanda.platform.svc.cluster.local:9092
RIDER_SERVICE_TOPIC=riders.telemetry

# --- Application: stream-ingestor ---
STREAM_INGESTOR_PORT=8082
STREAM_INGESTOR_REDPANDA_BROKERS=redpanda.platform.svc.cluster.local:9092
STREAM_INGESTOR_MINIO_ENDPOINT=http://minio.platform.svc.cluster.local:9000
STREAM_INGESTOR_BRONZE_BUCKET=lakehouse-bronze

# --- Application: traffic-generator ---
TRAFFIC_GENERATOR_KONG_GATEWAY_URL=http://kong-proxy.platform.svc.cluster.local:8000
