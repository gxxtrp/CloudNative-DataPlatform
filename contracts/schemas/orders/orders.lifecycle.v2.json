{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderLifecycleEvent",
  "description": "Versioned Order Lifecycle State Transition Event Contract",
  "type": "object",
  "metadata": {
    "domain": "food_delivery",
    "owner_team": "team-order-checkout@platform.local",
    "version": "2.0.0",
    "sla_freshness_seconds": 30
  },
  "required": [
    "event_id",
    "event_timestamp",
    "schema_version",
    "producer",
    "order_id",
    "order_status",
    "merchant_id",
    "customer_id",
    "total_amount_baht",
    "payment_method"
  ],
  "properties": {
    "event_id": {"type": "string", "format": "uuid", "description": "Stable logical event identifier for idempotency"},
    "event_timestamp": {"type": "string", "format": "date-time", "description": "Event occurrence timestamp in UTC"},
    "schema_version": {"type": "string", "const": "2.0.0", "description": "Contract version used to serialize this record"},
    "producer": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$", "description": "Named producer module"},
    "order_id": {"type": "string", "description": "Canonical Order identifier"},
    "order_status": {"type": "string", "enum": ["CREATED", "MERCHANT_ACCEPTED", "RIDER_ASSIGNED", "PICKED_UP", "DELIVERED", "CANCELLED"]},
    "merchant_id": {"type": "string", "description": "Merchant identifier"},
    "customer_id": {"type": "string", "description": "Customer identifier"},
    "rider_id": {"type": ["string", "null"], "description": "Assigned Rider identifier"},
    "total_amount_baht": {"type": "number", "minimum": 0, "description": "Gross Order amount in THB"},
    "payment_method": {"type": "string", "enum": ["LINE_PAY", "PROMPTPAY", "CREDIT_CARD", "CASH_ON_DELIVERY"]},
    "delivery_address": {
      "type": "object",
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "district": {"type": "string"},
        "province": {"type": "string", "default": "Bangkok"}
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "item_name", "quantity", "price_baht"],
        "properties": {
          "item_id": {"type": "string"},
          "item_name": {"type": "string"},
          "quantity": {"type": "integer", "minimum": 1},
          "price_baht": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
