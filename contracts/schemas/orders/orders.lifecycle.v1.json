{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderLifecycleEvent",
  "description": "Order Lifecycle State Transition Event Contract",
  "type": "object",
  "metadata": {
    "domain": "food_delivery",
    "owner_team": "team-order-checkout@platform.local",
    "version": "1.0.0",
    "sla_freshness_seconds": 30
  },
  "required": [
    "event_id",
    "event_timestamp",
    "order_id",
    "order_status",
    "merchant_id",
    "customer_id",
    "total_amount_baht",
    "payment_method"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event identifier for idempotency"
    },
    "event_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Event occurrence timestamp in UTC (ISO-8601)"
    },
    "order_id": {
      "type": "string",
      "description": "Canonical order identifier (e.g. ORD-20260906-8841)"
    },
    "order_status": {
      "type": "string",
      "enum": [
        "CREATED",
        "MERCHANT_ACCEPTED",
        "RIDER_ASSIGNED",
        "PICKED_UP",
        "DELIVERED",
        "CANCELLED"
      ],
      "description": "Current state machine status of the order"
    },
    "merchant_id": {
      "type": "string",
      "description": "Restaurant / Merchant identifier in POS system"
    },
    "customer_id": {
      "type": "string",
      "description": "Consumer user account identifier"
    },
    "rider_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Assigned delivery rider identifier (null until assigned)"
    },
    "total_amount_baht": {
      "type": "number",
      "minimum": 0,
      "description": "Total gross order transaction amount in Thai Baht (THB)"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "LINE_PAY",
        "PROMPTPAY",
        "CREDIT_CARD",
        "CASH_ON_DELIVERY"
      ],
      "description": "Payment instrument utilized for transaction settlement"
    },
    "delivery_address": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "district": {
          "type": "string"
        },
        "province": {
          "type": "string",
          "default": "Bangkok"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "item_name",
          "quantity",
          "price_baht"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "price_baht": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
