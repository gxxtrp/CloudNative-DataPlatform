{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RiderTelemetryEvent",
  "description": "Versioned Rider Telemetry Observation Contract",
  "type": "object",
  "metadata": {
    "domain": "rider_fleet",
    "owner_team": "team-rider-dispatch@platform.local",
    "version": "2.0.0",
    "sla_freshness_seconds": 15
  },
  "required": [
    "event_id",
    "event_timestamp",
    "schema_version",
    "producer",
    "rider_id",
    "latitude",
    "longitude",
    "geohash",
    "rider_status"
  ],
  "properties": {
    "event_id": {"type": "string", "format": "uuid", "description": "Stable logical event identifier for idempotency"},
    "event_timestamp": {"type": "string", "format": "date-time", "description": "Telemetry capture timestamp in UTC"},
    "schema_version": {"type": "string", "const": "2.0.0", "description": "Contract version used to serialize this record"},
    "producer": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$", "description": "Named producer module"},
    "rider_id": {"type": "string", "description": "Canonical Rider identifier"},
    "latitude": {"type": "number", "minimum": -90, "maximum": 90},
    "longitude": {"type": "number", "minimum": -180, "maximum": 180},
    "geohash": {"type": "string", "description": "Spatial geohash index"},
    "speed_kmh": {"type": "number", "minimum": 0},
    "heading_degrees": {"type": "number", "minimum": 0, "maximum": 360},
    "battery_level": {"type": "integer", "minimum": 0, "maximum": 100},
    "rider_status": {"type": "string", "enum": ["OFFLINE", "AVAILABLE", "EN_ROUTE_TO_MERCHANT", "WAITING_AT_MERCHANT", "DELIVERING_ORDER"]},
    "current_order_id": {"type": ["string", "null"], "description": "Assigned current Order, if any"}
  }
}
