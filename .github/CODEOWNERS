# ============================================================================
# PLATFORM TEAM - Infrastructure and platform services
# ============================================================================

# All infrastructure (Terraspace)
/infrastructure/ @platform-team

# Platform services (operators, monitoring, catalog)
/platform/ @platform-team

# Base Docker images
/images/*-base/ @platform-team

# Workflow templates (shared patterns)
/orchestration/templates/ @platform-team

# CI/CD workflows for infrastructure and platform
/.github/workflows/infrastructure.yaml @platform-team
/.github/workflows/platform.yaml @platform-team
/.github/workflows/images.yaml @platform-team

# Repository configuration
/.github/CODEOWNERS @platform-team
/.pre-commit-config.yaml @platform-team

