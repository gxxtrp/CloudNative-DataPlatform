# DBT Profiles - Copy to ~/.dbt/profiles.yml
# DO NOT commit actual credentials

data_platform:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: oauth  # or service-account
      project: dataplatform-dev
      dataset: gold  # Default dataset
      location: US
      threads: 4
      timeout_seconds: 300
      
      # For service account authentication (CI/CD)
      # method: service-account
      # keyfile: /path/to/keyfile.json

    staging:
      type: bigquery
      method: service-account
      project: dataplatform-staging
      dataset: gold
      location: US
      threads: 4
      timeout_seconds: 300
      keyfile: "{{ env_var('GOOGLE_APPLICATION_CREDENTIALS') }}"

    prod:
      type: bigquery
      method: service-account
      project: dataplatform-prod
      dataset: gold
      location: US
      threads: 8
      timeout_seconds: 600
      keyfile: "{{ env_var('GOOGLE_APPLICATION_CREDENTIALS') }}"
